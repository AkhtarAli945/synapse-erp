# Free MongoDB: MongoDB Atlas M0 (mongodb.com/atlas) or local mongodb://127.0.0.1:27017/synapse
MONGODB_URI=mongodb://127.0.0.1:27017/synapse
# Free LLM: create a key at console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Comma-separated allowed origins (your deployed frontend URL). Empty = allow all.
CLIENT_URL=http://localhost:5173
